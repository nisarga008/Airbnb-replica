<% layout('/layout/boilerplate') -%>
<body>
    <div class="row">
        <div class="col-8 offset-2 " >
   <form method="post" action="/listings" class="mt-3  needs-validation" novalidate enctype="multipart/form-data" >
    <div class="mb-3">
        <label for="title" class="form-label">Title</label>
        <input type="text" name="listing[title]" placeholder="title" class="form-control" required>
        <div class="valid-feedback">Title looks good!</div>
    </div>
    <div class="mb-3">
        <label for="description" class="form-label">Description</label>
        <textarea name="listing[description]" placeholder="description" class="form-control" required></textarea>
          <div class="valid-feedback"> Description looks good!</div>
    </div>
    <!-- <div class="mb-3">
  <label for="image" class="form-label">Image URL</label>
<input name="listing[image][url]" placeholder="Enter image URL" class="form-control" type="text" />

</div> -->
<div class="mb-3">
  <label for="image" class="form-label">Upload listing Image</label>
<input name="image" class="form-control" type="file" required />

</div>
    <div class="mb-3">
        <label for="price" class="form-label">Price</label>
        <input  name="listing[price]" placeholder="price" class="form-control" required>
        <div class="invalid-feedback">Please enter a valid price</div>
    </div>
    <div class="row">
        <div class="mb-3 col-md-4">
            <label for="location" class="form-label">Location</label>
            <input type="text" name="listing[location]" placeholder="location" class="form-control" required>
              <div class="invalid-feedback"> please enter valid location</div>
        </div>
        <div class="mb-3 col-md-8">
            <label for="country" class="form-label">Country</label>
            <input type="text" name="listing[country]" placeholder="country" class="form-control" required>
            <div class="invalid-feedback"> please enter valid country</div>
        </div>
    </div>
    <button class="btn btn-primary">Add</button>
</form>


     </div>
    </div>
</body>
</html>