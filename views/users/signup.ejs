<% layout('/layout/boilerplate') -%>

<div class="row">
    <h3 class="col-8 offset-3 ">SignUp on WanderLust</h3>
        <div class="col-8 offset-3 " >
            <form method="post" action="/signup" class="needs-validation" novalidate>
              <div class="mb-3">
        <label for="username" class="form-label">Username</label>
        <input type="text" name="username" id="username" class="form-control" required>
        <div class="valid-feedback">Username looks good!</div>
              </div>
              <div class="mb-3">
        <label for="email" class="form-label">Email</label>
        <input type="email" name="email" id="username" class="form-control" required>
              </div>
              <div class="mb-3">
        <label for="password" class="form-label">Password</label>
        <input type="password" name="password" id="password" class="form-control" required>
              </div>
              <button class="btn btn-danger">Sign Up</button>
            </form>
             </div>
              </div>